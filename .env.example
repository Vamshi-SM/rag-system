# ---------------------------------------------------------------------------
# RAG System — Environment Configuration Template
#
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------------------

# --- Paths ---
DATA_DIRECTORY=data/documents
PROCESSED_DIRECTORY=data/processed
DATABASE_PATH=data/processed/vectors.db

# --- Vector database backend ---
# "sqlite" (default, single-machine) or "postgres" (production / multi-user).
DATABASE_BACKEND=sqlite
# Required when DATABASE_BACKEND=postgres, e.g.
#   postgresql://user:password@host:5432/ragdb
DATABASE_URL=
# Max pooled PostgreSQL connections per process (postgres backend only).
DATABASE_POOL_SIZE=10

# --- Chunking ---
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# ---------------------------------------------------------------------------
# Hybrid Architecture: Local Embeddings (Ollama) + Remote Chat (SharedLLM)
# ---------------------------------------------------------------------------

# --- Embedding backend selection ---
# "ollama" (default: local, no key needed), "local" (fastembed, fully offline),
# "sharedllm" (OpenAI-compatible remote), or "google" (Vertex AI embeddings
# via GCP application-default credentials).
EMBEDDING_BACKEND=ollama
# Model used when EMBEDDING_BACKEND=local (fastembed)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Embeddings: local Ollama (no API key needed) ---
# Run:  ollama pull qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_BATCH_SIZE=32
# Max chars per embedding API request payload (2KB chunks need >=128000 for batch 64)
EMBEDDING_MAX_CHARS=20000
# Parallel in-flight embedding API requests during ingestion (1 = sequential)
EMBEDDING_CONCURRENCY=4
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=3
# Max tokens per embedding request (parallel batches are sized to fit)
EMBEDDING_TOKEN_BUDGET=19000

# --- Reranker (optional cross-encoder re-ranking) ---
# Measured as unnecessary for the benchmark corpus; leave off unless hit@1 drops.
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TOP_N=20

# --- Prompt context budget ---
# Per-chunk trim and total context ceiling fed to the LLM
PROMPT_MAX_CHUNK_CHARS=1800
PROMPT_MAX_CONTEXT_CHARS=9000

# --- Google Cloud (Vertex AI embeddings + RAG Engine) ---
# Auth: gcloud auth application-default login (user) or a service account.
# The project must have billing enabled and aiplatform.googleapis.com activated.
# us-central1 is the benchmarked RAG Engine region.
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
# RAG Engine corpus resource name (written by scripts/setup_rag_engine.py)
RAG_CORPUS_NAME=
RAG_CORPUS_DISPLAY_NAME=rag-benchmark-corpus
# GCS bucket staging corpus files before import (auto-created if missing)
RAG_GCS_BUCKET=

# --- SharedLLM API credentials ---
# Get your key from https://app.sharedllm.com
SHAREDLLM_API_KEY=your-api-key-here
# Legacy alias — keep in sync with SHAREDLLM_API_KEY
SLLM_API_KEY=your-api-key-here

# --- SharedLLM endpoint URLs ---
# Embedding endpoint (OpenAI-compatible)
SLLM_BASE_URL=https://api.sharedllm.com/openai/v1

# Chat endpoint (Ollama-compatible)  ← used by SLLMChat / SharedLLMChat
SHAREDLLM_CHAT_BASE_URL=https://api.sharedllm.com/ollama
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# --- Retrieval ---
TOP_K=5
# 0.20 is the tuned floor for the benchmark corpus (below it, results are noise)
SIMILARITY_THRESHOLD=0.20
RETRIEVAL_CANDIDATE_MULTIPLIER=4

# --- Chat / LLM (SharedLLM remote) ---
CHAT_MODEL=deepseek-v4-flash
REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=3

# --- API security ---
# POST /ingest only accepts folders inside this root (defaults to the
# parent of DATA_DIRECTORY). Prevents path-traversal to arbitrary
# filesystem locations.
ALLOWED_INGEST_ROOT=data

# Comma-separated CORS origins, e.g. https://app.example.com
# Leave blank to disable cross-origin access entirely.
ALLOWED_CORS_ORIGINS=

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIRECTORY=logs
