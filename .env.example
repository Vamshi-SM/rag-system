# ---------------------------------------------------------------------------
# RAG System — Environment Configuration Template
#
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------------------

# --- Paths ---
DATA_DIRECTORY=data/documents
PROCESSED_DIRECTORY=data/processed
DATABASE_PATH=data/processed/vectors.db

# --- Chunking ---
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# ---------------------------------------------------------------------------
# Hybrid Architecture: Local Embeddings (Ollama) + Remote Chat (SharedLLM)
# ---------------------------------------------------------------------------

# --- Embeddings: local Ollama (no API key needed) ---
# Run:  ollama pull qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=3

# --- SharedLLM API credentials ---
# Get your key from https://app.sharedllm.com
SHAREDLLM_API_KEY=your-api-key-here
# Legacy alias — keep in sync with SHAREDLLM_API_KEY
SLLM_API_KEY=your-api-key-here

# --- SharedLLM endpoint URLs ---
# Embedding endpoint (OpenAI-compatible)
SLLM_BASE_URL=https://api.sharedllm.com/openai/v1

# Chat endpoint (Ollama-compatible)  ← used by SLLMChat / SharedLLMChat
SHAREDLLM_CHAT_BASE_URL=https://api.sharedllm.com/ollama
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# --- Retrieval ---
TOP_K=5
SIMILARITY_THRESHOLD=0.3
RETRIEVAL_CANDIDATE_MULTIPLIER=4

# --- Chat / LLM (SharedLLM remote) ---
CHAT_MODEL=deepseek-v4-flash
REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=3

# --- API security ---
# POST /ingest only accepts folders inside this root (defaults to the
# parent of DATA_DIRECTORY). Prevents path-traversal to arbitrary
# filesystem locations.
ALLOWED_INGEST_ROOT=data

# Comma-separated CORS origins, e.g. https://app.example.com
# Leave blank to disable cross-origin access entirely.
ALLOWED_CORS_ORIGINS=

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIRECTORY=logs
