# --- Paths ---
DATA_DIRECTORY=data/documents
PROCESSED_DIRECTORY=data/processed
DATABASE_PATH=data/processed/vectors.db

# --- Chunking ---
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# --- Embeddings (SLLM / Qwen API) ---
SLLM_API_KEY=your-api-key-here
SLLM_BASE_URL=https://api.example-sllm.com/v1
EMBEDDING_MODEL=qwen-embedding
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=3

# --- Retrieval ---
TOP_K=5
SIMILARITY_THRESHOLD=0.3
RETRIEVAL_CANDIDATE_MULTIPLIER=4

# --- Chat / LLM (SLLM API) ---
CHAT_MODEL=qwen-chat
REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=3

# --- API security ---
# POST /ingest only accepts folders inside this root (defaults to the
# parent of DATA_DIRECTORY). Prevents path-traversal to arbitrary
# filesystem locations.
ALLOWED_INGEST_ROOT=data
# Comma-separated CORS origins, e.g. https://app.example.com,https://admin.example.com
# Leave blank to disable cross-origin access entirely.
ALLOWED_CORS_ORIGINS=

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIRECTORY=logs
